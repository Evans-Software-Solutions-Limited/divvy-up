{
  "name": "@divvy-up/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --passWithNoTests --coverage",
    "build": "echo 'Mobile build handled by EAS'"
  },
  "dependencies": {
    "@azure/core-asynciterator-polyfill": "^1.0.2",
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/hanken-grotesk": "^0.4.3",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@journeyapps/react-native-quick-sqlite": "^2.5.2",
    "@powersync/common": "^1.57.0",
    "@powersync/react-native": "^1.35.7",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "2.105.4",
    "@tamagui/animations-react-native": "^2.0.0-rc.40",
    "@tamagui/babel-plugin": "^2.0.0-rc.40",
    "@tamagui/core": "^2.0.0-rc.40",
    "@tanstack/react-query": "^5.62.0",
    "expo": "^55.0.0",
    "expo-apple-authentication": "~55.0.13",
    "expo-build-properties": "~55.0.13",
    "expo-camera": "~55.0.20",
    "expo-constants": "~55.0.14",
    "expo-device": "^55.0.15",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.15",
    "expo-image": "~55.0.11",
    "expo-image-manipulator": "^55.0.16",
    "expo-image-picker": "^55.0.20",
    "expo-linear-gradient": "^55.0.13",
    "expo-linking": "~55.0.13",
    "expo-notifications": "~55.0.19",
    "expo-router": "~55.0.12",
    "expo-splash-screen": "~55.0.18",
    "expo-status-bar": "~55.0.5",
    "expo-web-browser": "^55.0.14",
    "lucide-react-native": "^1.17.0",
    "react": "19.2.0",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "2.31.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-async-generator-functions": "^7.23.9",
    "@babel/runtime": "^7.25.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~55.0.8",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.16",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.{ts,tsx}",
      "**/*.test.{ts,tsx}",
      "<rootDir>/eslint-rules/__tests__/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/__tests__/setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(.bun/.*/)?(react-native|@react-native|@react-native-community|expo|expo-[^/]*|@expo|expo-modules-core|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|react-native-svg|tamagui|@tamagui|react-native-reanimated|react-native-worklets|@powersync|@journeyapps)/)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!**/*.types.ts",
      "!**/index.ts",
      "!**/__tests__/**",
      "!**/ports/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 0,
        "functions": 0,
        "lines": 0,
        "statements": 0
      }
    }
  }
}
