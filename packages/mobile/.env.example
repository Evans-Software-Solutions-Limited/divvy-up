# Local-dev env for `expo run:ios` / `expo run:android`. Copy to `.env`, edit values.
#
# Staging + production builds DO NOT read this file — those inject EXPO_PUBLIC_*
# vars via eas.json (build.<profile>.env). This file is only for local builds.
#
# NOTE: the Divvy Up backend (Supabase Postgres) and PowerSync sync service are
# not wired yet — these are placeholders for the shell. See
# docs/local-first-sqlite-sync-research.md for the sync-stack plan.

# API base URL (SST core service). Override with the URL from `bun run sst dev`.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Supabase project — auth (and later the PowerSync sync source). Auth only from
# the client; never direct DB queries.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# PowerSync instance URL (added when sync is wired in a later phase).
# EXPO_PUBLIC_POWERSYNC_URL=https://your-instance.powersync.journeyapps.com
